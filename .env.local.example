# MauroMotion Environment Variables
# Copy this file to .env.local and fill in your values

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_ENGINE_URL=http://localhost:8000

# InsForge (Backend as a Service)
NEXT_PUBLIC_INSFORGE_URL=https://your-project.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=ik_your-anon-key-here

# OpenRouter API key for AI generation (optional for now)
# OPENROUTER_API_KEY=your-openrouter-api-key

# Backend (Python) - set in services/engine/.env or as system env
# DATABASE_URL=postgresql://user:pass@host:port/db
# SECRET_KEY=your-secret-key-for-jwt
# OPENROUTER_API_KEY=your-openrouter-api-key